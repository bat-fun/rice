@import "~/.cache/noir-signal/rofi-colors.rasi"

configuration {
    modi: "drun";
    show-icons: true;

    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";

    display-drun: "APPS : ";

    kb-cancel: "Escape";
    kb-accept-entry: "Return";
    kb-remove-to-eol: "Control+E";
    kb-remove-to-sol: "Control+A";
}

* {
    bg:         @noir-bg;
    surface:    @noir-surface;
    surface-alt: @noir-surface-alt;

    text:       @noir-text;
    muted:      @noir-muted;
    accent:     @noir-accent;

    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 400px;
    height: 400px;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 14px;
    border-left: 3px;
    border-left-color: @accent;

    background-color: @bg;

    padding: 20px;
}

mainbox {
    spacing: 16px;
    children: [
        inputbar,
        listview
    ];
}

inputbar {
    padding: 12px 14px;

    background-color: @surface;
    border: 1px;
    border-color: @noir-outline;
    border-radius: 9px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    enabled: true;
    text-color: @accent;
}

entry {
    placeholder: " Search applications...";
    placeholder-color: @muted;

    text-color: @text;
    cursor: text;
}

listview {
    columns: 1;
    lines: 6;

    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 12px 14px;
    border-radius: 8px;

    background-color: transparent;
}

element-icon {
    size: 25px;
    margin: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
    text-color: @muted;
}

element selected {
    background-color: @surface-alt;
    border: 1px;
    border-color: @accent;
    border-left: 3px;
    border-left-color: @accent;
    padding: 12px 14px 12px 11px;
}

element selected element-text {
    text-color: @accent;
}

element selected element-icon {
    opacity: 1;
}