@import "~/.cache/noir-signal/rofi-colors.rasi"

configuration {
    show-icons: false;

    kb-cancel: "Escape";
    kb-accept-entry: "Return";
}

* {
    bg:         @noir-bg;
    surface:    @noir-surface;
    surface-alt: @noir-surface-alt;

    text:       @noir-text;
    muted:      @noir-muted;
    accent:     @noir-accent;

    background-color: transparent;
    text-color: @text;

    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 680px;
    height: 360px;

    border: 1px;
    border-color: @noir-outline;
    border-radius: 14px;

    border-left: 3px;
    border-left-color: @accent;

    background-color: @bg;

    padding: 20px;
}

mainbox {
    spacing: 16px;

    children: [
        inputbar,
        listview
    ];
}

inputbar {
    padding: 12px 14px;

    background-color: @surface;

    border: 1px;
    border-color: @noir-outline;
    border-radius: 9px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    enabled: true;
    text-color: @accent;
}

entry {
    placeholder: "Switch workspace...";
    placeholder-color: @muted;

    text-color: @text;
}

listview {
    columns: 1;
    lines: 7;

    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 12px 16px;
    border-radius: 9px;

    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    text-color: @muted;
}

element selected {
    background-color: @surface-alt;

    border: 1px;
    border-color: @accent;

    border-left: 3px;
    border-left-color: @accent;

    padding: 12px 16px 12px 13px;
}

element selected element-text {
    text-color: @accent;
}